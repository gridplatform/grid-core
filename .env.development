# Local development — used by `npm run dev` only.
# Production uses `.env` only (`npm start` / `npm run prod`). Never mixed.

PORT=3000

GRID_AUTH_ADMIN_EMAIL=admin@grid.local
GRID_AUTH_ADMIN_PASSWORD=changeme

GRID_CLI_ROOT=../grid-cli
GRID_CONFIG_ROOT=../grid-config
GRID_MODULE_BANK=../grid-terraform
GRID_MODULE_BANK_REF=main
GRID_MODULE_SOURCE=link
GRID_DATA_DIR=./data
GRID_WORK_DIR=./workspaces

GRID_GITOPS_SYNC_INTERVAL_SEC=0
GRID_MODULE_BANK_SYNC_INTERVAL_SEC=20
