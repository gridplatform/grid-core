# Copy to install/.env and edit before compose or install.sh:
#   cp install/.env.example install/.env
#
# Production install — install/check-env.sh refuses incomplete settings.
# Local laptop development uses package `.env.development` — never this file.

# Auth (required — no placeholder passwords)
GRID_AUTH_ADMIN_EMAIL=admin@example.com
GRID_AUTH_ADMIN_PASSWORD=

# HTTP
GRID_HTTP_PORT=80

# Release images (docker-compose.release.yml)
# GRID_RELEASE_CHANNEL: current | lts
# GRID_VERSION: exact tag (overrides channel), e.g. 0.1.0
GRID_RELEASE_CHANNEL=current
# GRID_VERSION=0.1.0
# GRID_CORE_IMAGE=ghcr.io/gridplatform/grid-core:0.1.0
# GRID_UI_IMAGE=ghcr.io/gridplatform/grid-ui:0.1.0

# Desired state and modules (release tag, not main)
# Intent repo — any Git host (GitHub, GitLab, Bitbucket, Gitea, …). Prefer a clean HTTPS/SSH URL.
GRID_GITOPS_REPO_URL=https://github.com/gridplatform/grid-config.git
GRID_GITOPS_BRANCH=main
# HTTPS remotes: username + token + expiry required for npm run prod / check-env
# (or save all three via Admin → Sources). Without them, production will not start.
# SSH remotes (git@…) skip this — use a host deploy key.
# Token is issued by your Git host (PAT / deploy token) — Grid does not mint it.
GRID_GITOPS_USERNAME=git
GRID_GITOPS_TOKEN=
GRID_GITOPS_TOKEN_EXPIRES_AT=2027-01-15
GRID_MODULE_BANK=https://github.com/gridplatform/grid-terraform.git
GRID_MODULE_BANK_REF=v0.1.0
GRID_MODULE_BANK_SYNC_INTERVAL_SEC=20
# GRID_MODULE_SOURCE=remote

# Terraform remote state + archive/ mirror — required
# https://gridplatform.org/doc/Install/Remote_State
# Same bucket: grid/…/terraform.tfstate and archive/…/*.tf
GRID_TF_BACKEND=s3
GRID_TF_STATE_BUCKET=
GRID_TF_LOCK_TABLE=
GRID_TF_STATE_REGION=us-east-1
# GRID_TF_BACKEND=gcs
# GRID_TF_STATE_BUCKET=
# GRID_TF_BACKEND=azurerm
# GRID_TF_AZURE_RESOURCE_GROUP=
# GRID_TF_AZURE_STORAGE_ACCOUNT=
# GRID_TF_AZURE_CONTAINER=grid-tfstate
# GRID_TF_BACKEND=oci
# GRID_TF_OCI_NAMESPACE=
# GRID_TF_S3_ENDPOINT=
# GRID_TF_BACKEND=oss
# GRID_TF_S3_ENDPOINT=
# GRID_TF_BACKEND=cos
# GRID_TF_STATE_REGION=ap-guangzhou
# GRID_TF_BACKEND=s3compat
# GRID_TF_S3_ENDPOINT=https://obs.cn-north-1.myhuaweicloud.com

# Source builds (docker-compose.yml)
GRID_CLI_REF=main
GRID_UI_REF=main
# GRID_UI_CONTEXT=../../grid-ui
TERRAFORM_VERSION=1.9.8

# Monitoring (host Prometheus + Alertmanager). Required for production boot.
# Install: sudo bash install/monitoring/install-systemd.sh
# Docs: install/monitoring/README.md
#
# VM Compose → host:
GRID_PROMETHEUS_URL=http://host.docker.internal:9090
GRID_ALERTMANAGER_URL=http://host.docker.internal:9093
GRID_MONITORING_CONFIG_DIR=/etc/prometheus
GRID_MONITORING_HOST_DIR=/etc/prometheus
#
# Local npm run prod (host binaries in terminals):
# GRID_PROMETHEUS_URL=http://127.0.0.1:9090
# GRID_ALERTMANAGER_URL=http://127.0.0.1:9093
# GRID_MONITORING_CONFIG_DIR=./install/monitoring
