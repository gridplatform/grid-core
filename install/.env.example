# Grid install env — copy to install/.env and edit before compose/up or install.sh
#
#   cp install/.env.example install/.env

# --- Auth (required) ---
GRID_AUTH_ADMIN_EMAIL=admin@grid.local
GRID_AUTH_ADMIN_PASSWORD=change-me-before-production

# --- HTTP ---
GRID_HTTP_PORT=80

# --- Desired-state / modules ---
GRID_GITOPS_REPO_URL=https://github.com/gridplatform/grid-config.git
GRID_GITOPS_BRANCH=main
GRID_MODULE_BANK=https://github.com/gridplatform/grid-terraform.git
GRID_MODULE_BANK_REF=main

# Lab convenience — set false once you care about approval UX
GRID_AUTO_APPROVE=true

# Pin sibling builds (compose / Dockerfile args)
GRID_CLI_REF=main
# Optional: local path to grid-ui when developing compose without GitHub fetch
# GRID_UI_CONTEXT=../../grid-ui
TERRAFORM_VERSION=1.9.8
