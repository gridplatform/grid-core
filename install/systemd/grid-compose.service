[Unit]
Description=Grid Platform (Docker Compose — production)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/grid/grid-core
# Hard-check install/.env then start (no skip flags)
ExecStart=/bin/bash /opt/grid/grid-core/install/compose-up.sh -- up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f /opt/grid/grid-core/install/docker-compose.yml --env-file /opt/grid/grid-core/install/.env stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
