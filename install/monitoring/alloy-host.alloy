// Optional Alloy on the Grid VM itself (host metrics → local Prometheus).
// Managed infrastructure units should use API-generated collector.alloy files instead.
//
// Env (optional): GRID_PROM_REMOTE_WRITE_URL — defaults to local Prometheus.

prometheus.exporter.unix "node" { }

prometheus.scrape "node" {
  targets    = prometheus.exporter.unix.node.targets
  forward_to = [prometheus.relabel.grid_vm.receiver]
}

prometheus.relabel "grid_vm" {
  forward_to = [prometheus.remote_write.local.receiver]
  rule {
    target_label = "job"
    replacement  = "grid-vm"
  }
}

prometheus.remote_write "local" {
  endpoint {
    url = coalesce(sys.env("GRID_PROM_REMOTE_WRITE_URL"), "http://127.0.0.1:9090/api/v1/write")
  }
}
