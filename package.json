{
  "name": "@gridplatform/grid-core",
  "version": "0.1.0",
  "description": "Grid Platform Core API - Infrastructure Orchestration Platform Backend",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "docker:build": "docker build -t grid-core .",
    "docker:run": "docker run -p 3000:3000 grid-core"
  },
  "keywords": [
    "infrastructure",
    "orchestration",
    "devops",
    "terraform",
    "kubernetes",
    "api"
  ],
  "author": "Grid Platform Team <team@gridplatform.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gridplatform/grid-core.git"
  },
  "bugs": {
    "url": "https://github.com/gridplatform/grid-core/issues"
  },
  "homepage": "https://github.com/gridplatform/grid-core#readme",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "pg": "^8.11.3",
    "redis": "^4.6.8",
    "ws": "^8.13.0",
    "uuid": "^9.0.0",
    "winston": "^3.10.0",
    "prometheus-client": "^14.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/compression": "^1.7.2",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.5.0",
    "@types/pg": "^8.10.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/bcryptjs": "^2.4.2",
    "@types/ws": "^8.5.5",
    "@types/uuid": "^9.0.2",
    "@types/jest": "^29.5.4",
    "@types/supertest": "^2.0.12",
    "typescript": "^5.1.6",
    "tsx": "^3.12.7",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "eslint": "^8.47.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "prettier": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
