{
  "name": "@gridplatform/grid-core",
  "version": "0.1.0",
  "description": "Grid Platform Core API — backend for Grid Console",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "GRID_APP_ENV=development tsx watch src/index.ts",
    "prod": "GRID_APP_ENV=production npm run build && GRID_APP_ENV=production node dist/index.js",
    "start": "GRID_APP_ENV=production node dist/index.js",
    "start:prod": "GRID_APP_ENV=production node dist/index.js",
    "build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gridplatform/grid-core.git"
  },
  "bugs": {
    "url": "https://github.com/gridplatform/grid-core/issues"
  },
  "homepage": "https://github.com/gridplatform/grid-core#readme",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "uuid": "^11.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/fs-extra": "^11.0.4",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
