# Grid Core (API) — owns platform paths. CLI inherits these when Core spawns it.

PORT=3000
GRID_DATA_DIR=./data
GRID_WORK_DIR=./workspaces

# Add-on: grid-cli package root
GRID_CLI_ROOT=../grid-cli

# Desired-state root (local demo GitOps tree — NOT grid-config for now)
# Contains infrastructures/demo-vpc/grid.json
GRID_CONFIG_ROOT=./examples/gitops-repo

# Terraform module bank
GRID_MODULE_BANK=../grid-terraform

GRID_TERRAFORM_BIN=terraform
GRID_AUTO_APPROVE=true

# Optional — remote state for generated workspaces:
# GRID_TF_BACKEND=s3
# GRID_TF_STATE_BUCKET=
# GRID_TF_LOCK_TABLE=
# GRID_TF_STATE_REGION=ap-south-1

# Optional remote GitOps (when not using the local examples/ tree):
# GRID_GITOPS_REPO_URL=
# GRID_GITOPS_BRANCH=main
# GRID_GITOPS_PATH=infrastructures
# GRID_GITOPS_SYNC_INTERVAL_SEC=0

# Feature flags (UI only): grid-ui/src/config/featureFlags.ts
