# Grid Core (API) — owns platform paths. CLI inherits these when Core spawns it.

PORT=3000
GRID_DATA_DIR=./data
GRID_WORK_DIR=./workspaces

# Add-on: grid-cli package root
GRID_CLI_ROOT=../grid-cli

# Desired-state working tree (clone / pull target for GitOps)
GRID_CONFIG_ROOT=./data/desired-state
# Local fixture only (skip remote GitOps):
# GRID_CONFIG_ROOT=../demo-infra
# GRID_USE_DEMO=1

# Module bank: public git URL (preferred) or local path
# Remote URL → cloned once into GRID_DATA_DIR/module-bank (VM disk / K8s PVC).
# Generate uses that local checkout; Sync modules on the GitOps page (or interval below).
GRID_MODULE_BANK=https://github.com/gridplatform/grid-terraform.git
GRID_MODULE_BANK_REF=main
# Optional auto-pull for module bank (seconds). 0 = manual Sync only (recommended).
# GRID_MODULE_BANK_SYNC_INTERVAL_SEC=0
# Override checkout path (defaults to GRID_DATA_DIR/module-bank):
# GRID_MODULE_BANK_CACHE=./data/module-bank
# Local override for development:
# GRID_MODULE_BANK=../grid-terraform

GRID_TERRAFORM_BIN=terraform
GRID_AUTO_APPROVE=true

# Optional — remote state for generated workspaces (recommended on any VM):
# Create the store first — see grid-docs docs/install/remote-state.md
# GRID_TF_BACKEND=s3
# GRID_TF_STATE_BUCKET=
# GRID_TF_LOCK_TABLE=
# GRID_TF_STATE_REGION=us-east-1
# GRID_TF_BACKEND=gcs
# GRID_TF_STATE_BUCKET=
# GRID_TF_BACKEND=azurerm
# GRID_TF_AZURE_RESOURCE_GROUP=
# GRID_TF_AZURE_STORAGE_ACCOUNT=
# GRID_TF_AZURE_CONTAINER=grid-tfstate

# Remote GitOps (desired-state source of truth)
GRID_GITOPS_REPO_URL=https://github.com/gridplatform/grid-config.git
GRID_GITOPS_BRANCH=main
# GRID_GITOPS_PATH=
# Auto git pull + reconcile (seconds). Default 600 when GRID_GITOPS_REPO_URL is set; 0 = off
GRID_GITOPS_SYNC_INTERVAL_SEC=600

# Authentication (internal user DB at GRID_DATA_DIR/users.json)
GRID_AUTH_ADMIN_EMAIL=admin@grid.local
GRID_AUTH_ADMIN_PASSWORD=change-me-before-production
# GRID_AUTH_ADMIN_NAME=Grid Admin
# GRID_AUTH_SESSION_TTL_HOURS=168
# GRID_AUTH_ALLOW_REGISTER=false
# GRID_AUTH_DISABLED=true

# Feature flags (UI only): grid-ui/src/config/featureFlags.ts
