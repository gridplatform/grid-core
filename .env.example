# Grid Core (API)

PORT=3000
GRID_DATA_DIR=./data
GRID_WORK_DIR=./workspaces
GRID_CLI_ROOT=../grid-cli
GRID_TERRAFORM_BIN=terraform
GRID_AUTO_APPROVE=true

# Optional — when generating via CLI, toggle remote state:
# GRID_TF_BACKEND=s3
# GRID_TF_STATE_BUCKET=
# GRID_TF_LOCK_TABLE=
# GRID_TF_STATE_REGION=ap-south-1

# Feature flags are source config, not env — see src/config/featureFlags.ts
