# Production / VM — copy to `.env` for `npm start` / `npm run prod`.
# Local development uses `.env.development` only (`npm run dev`). Never mixed.
#
# `npm run prod` REFUSES to boot unless every required value below is set.
# There is no override flag — use `npm run dev` on a laptop.

PORT=3000
GRID_DATA_DIR=./data
GRID_WORK_DIR=./workspaces

# Add-on: grid-cli package root (on a VM this is often /opt/grid/grid-cli)
GRID_CLI_ROOT=../grid-cli

# Desired-state working tree (clone / pull target for GitOps)
GRID_CONFIG_ROOT=./data/desired-state
GRID_GITOPS_REPO_URL=https://github.com/gridplatform/grid-config.git
GRID_GITOPS_BRANCH=main
# Auto git pull + reconcile (seconds). Default 600 when GRID_GITOPS_REPO_URL is set; 0 = off
GRID_GITOPS_SYNC_INTERVAL_SEC=600

# Module bank — released tag (v0.1.0), not main / not a local path
GRID_MODULE_BANK=https://github.com/gridplatform/grid-terraform.git
GRID_MODULE_BANK_REF=v0.1.0
# GRID_MODULE_SOURCE=remote
GRID_MODULE_BANK_SYNC_INTERVAL_SEC=20

GRID_TERRAFORM_BIN=terraform

# Argo CD / OpenShift GitOps — Kubernetes workloads (Application CRs)
# Same CRD for upstream Argo and OpenShift GitOps operator.
# GRID_ARGO_ENABLED=1
# GRID_ARGO_KUBECONFIG=/path/to/kubeconfig
# GRID_ARGO_CONTEXT=
# GRID_ARGO_NAMESPACE=argocd
# GRID_KUBECTL_BIN=kubectl

# Remote Terraform state + archive/ mirror — required (create store first):
# https://github.com/gridplatform/grid-docs/blob/main/docs/install/remote-state.md
# Same bucket holds:
#   grid/<unit>/terraform.tfstate   ← Terraform state
#   archive/<unit>/*.tf             ← generated instance Terraform (exit buffer)
GRID_TF_BACKEND=s3
GRID_TF_STATE_BUCKET=
GRID_TF_LOCK_TABLE=
GRID_TF_STATE_REGION=us-east-1
# GRID_TF_BACKEND=gcs
# GRID_TF_STATE_BUCKET=
# GRID_TF_BACKEND=azurerm
# GRID_TF_AZURE_RESOURCE_GROUP=
# GRID_TF_AZURE_STORAGE_ACCOUNT=
# GRID_TF_AZURE_CONTAINER=grid-tfstate
# GRID_TF_BACKEND=oci
# GRID_TF_STATE_BUCKET=
# GRID_TF_OCI_NAMESPACE=
# GRID_TF_S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# GRID_TF_BACKEND=oss
# GRID_TF_STATE_BUCKET=
# GRID_TF_STATE_REGION=cn-hangzhou
# GRID_TF_S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# GRID_TF_BACKEND=cos
# GRID_TF_STATE_BUCKET=mycompany-grid-tfstate-<appid>
# GRID_TF_STATE_REGION=ap-guangzhou
# GRID_TF_BACKEND=s3compat
# GRID_TF_STATE_BUCKET=
# GRID_TF_STATE_REGION=cn-north-1
# GRID_TF_S3_ENDPOINT=https://obs.cn-north-1.myhuaweicloud.com
# GRID_TF_S3_FORCE_PATH_STYLE=true

# Authentication (required — no placeholder passwords)
GRID_AUTH_ADMIN_EMAIL=admin@example.com
GRID_AUTH_ADMIN_PASSWORD=
